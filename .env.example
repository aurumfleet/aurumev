# =============================================================================
# AURUM EV - Aurum Fleet Solutions Pvt Ltd
# Environment Configuration Template
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AURUM EV"
NEXT_PUBLIC_WHATSAPP_NUMBER=
NODE_ENV=development

# Database (PostgreSQL / Supabase)
# Leave empty or set to pglite://./data/aurum-pgdata for embedded local PostgreSQL
# For production PostgreSQL / Supabase, set:
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_URL=pglite://./data/aurum-pgdata

# Supabase (Optional - for managed PostgreSQL, Supabase Auth, and Private KYC Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication & Session Security (CONFIDENTIAL — server-only, leave empty in template)
# Generate a strong 32+ byte random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SESSION_COOKIE_NAME=aurum_session

# Private File Storage (Local fallback ./storage/private or S3/Supabase)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/private

# Transactional Email (SMTP / Resend)
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AURUM EV <info@aurumfleets.com>"

# SMS / WhatsApp Notification Adapters
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payment Gateway Adapter (Indian Payment Gateways: razorpay | cashfree | none)
PAYMENT_GATEWAY_PROVIDER=none
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_TEST_MODE=true

# Analytics (Google Analytics 4 & Google Tag Manager)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
